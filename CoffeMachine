const prompt = require("prompt-sync")({ sigint: true });

// Enumération des états possibles
const EtatMachine = {
    ETEINTE: "Éteinte",
    EN_FONCTION: "En fonction",
    MAINTENANCE: "Maintenance"
};

// Classe Boisson
class Boisson {
    constructor(nom, prix, stock) {
        this.nom = nom;
        this.prix = prix;
        this.stock = stock;
    }

    estDisponible() {
        return this.stock > 0;
    }

    servir() {
        if (this.estDisponible()) {
            this.stock--;
        }
    }
}

// Classe CoffeeMachine
class CoffeeMachine {
    constructor() {
        this.etat = EtatMachine.ETEINTE;
        this.menu = [
            new Boisson("Expresso", 1.5, 5),
            new Boisson("Café long", 2.0, 5),
            new Boisson("Cappuccino", 2.5, 3),
            new Boisson("Thé", 1.8, 4)
        ];
        this.reservoirEau = 10; // en litres
        this.bacDechets = 0; // en nombre d'utilisations
        this.LIMITE_BAC_DECHETS = 10;
    }

    demarrer() {
        console.log(" Démarrage de la machine à café...");
        this.etat = EtatMachine.EN_FONCTION;
        this.bouclePrincipale();
    }

    afficherMenu() {
        console.log("Menu des boissons :");
        this.menu.forEach((boisson, index) => {
            console.log(`${index + 1}. ${boisson.nom} - ${boisson.prix.toFixed(2)} € (${boisson.stock} en stock)`);
        });
    }

    demanderBoisson() {
        const choix = parseInt(prompt("\nEntrez le numéro de la boisson souhaitée : "));
        if (isNaN(choix) || choix < 1 || choix > this.menu.length) {
            throw new Error(" Choix invalide.");
        }
        return this.menu[choix - 1];
    }

    verifierEtatMachine() {
        if (this.reservoirEau <= 0) {
            throw new Error(" Réservoir d’eau vide. Maintenance requise.");
        }
        if (this.bacDechets >= this.LIMITE_BAC_DECHETS) {
            throw new Error(" Bac à déchets plein. Maintenance requise.");
        }
    }

    demanderPaiement(prix) {
        const montant = parseFloat(prompt(`Insérez ${prix.toFixed(2)} € : `));
        if (isNaN(montant) || montant < prix) {
            throw new Error(" Montant insuffisant.");
        }
        const rendu = (montant - prix).toFixed(2);
        if (rendu > 0) {
            console.log(` Rendu : ${rendu} €`);
        }
    }

    preparerBoisson(boisson) {
        console.log(`☕ Préparation de votre ${boisson.nom}...`);
        boisson.servir();
        this.reservoirEau -= 0.2; // consommation d'eau
        this.bacDechets += 1;
        console.log(" Boisson servie. Bonne dégustation !");
    }

    bouclePrincipale() {
        while (this.etat === EtatMachine.EN_FONCTION) {
            try {
                this.verifierEtatMachine();
                this.afficherMenu();
                const boisson = this.demanderBoisson();

                if (!boisson.estDisponible()) {
                    throw new Error(" Boisson en rupture de stock.");
                }

                this.demanderPaiement(boisson.prix);
                this.preparerBoisson(boisson);
            } catch (error) {
                console.log(error.message);
            }

            const continuer = prompt("\nSouhaitez-vous commander une autre boisson ? (o/n) : ").toLowerCase();
            if (continuer !== 'o') {
                this.etat = EtatMachine.ETEINTE;
                console.log(" Merci d’avoir utilisé la machine à café. À bientôt !");
            }
        }
    }
}

// Exécution
const machine = new CoffeeMachine();
machine.demarrer();
